<Window x:Class="WEP.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WEP Host — Antigravity Remote Gateway"
        Icon="pack://application:,,,/Assets/wep.ico"
        Width="1120" Height="740" MinWidth="920" MinHeight="640"
        Background="#0B0D12"
        Foreground="#F3F4F6"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Antigravity Header -->
        <Border Grid.Row="0" Background="#12151E" BorderBrush="#262B3D" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/wep.ico" Width="34" Height="34" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="WEP Host Gateway" FontSize="15" FontWeight="SemiBold" Foreground="#F3F4F6"/>
                        <TextBlock Text="Antigravity Remote Bridge &amp; Tunnel Manager" FontSize="11.5" Foreground="#9CA3AF"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#171B26" BorderBrush="#262B3D" BorderThickness="1" CornerRadius="14" Padding="12,5" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ServerDot" Width="8" Height="8" Fill="#22C55E" Margin="0,0,7,0"/>
                            <TextBlock x:Name="HeaderServerStatus" Text="Gateway Online" FontSize="12" Foreground="#E5E7EB"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#171B26" BorderBrush="#262B3D" BorderThickness="1" CornerRadius="14" Padding="12,5" Margin="0,0,10,0">
                        <TextBlock x:Name="HeaderClientsBadge" Text="0 iOS Connected" FontSize="12" Foreground="#38BDF8"/>
                    </Border>
                    <Button Content="Minimize to Tray" Style="{StaticResource SecondaryBtn}" Click="MinimizeToTray_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Connection & QR Pairing -->
            <StackPanel Grid.Column="0">
                <!-- Gateway & Tunnel Status Card -->
                <Border Background="#12151E" BorderBrush="#262B3D" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="REMOTE PATHWAY" FontSize="11" FontWeight="Bold" Foreground="#6366F1" Margin="0,0,0,10"/>

                        <TextBlock Text="Public Tunnel URL (4G / 5G / Anywhere)" FontSize="11.5" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TunnelUrlBox" Style="{StaticResource DarkTextBox}" IsReadOnly="True"
                                     Text="Waiting for tunnel..." FontFamily="Consolas" FontSize="12"/>
                            <Button Grid.Column="1" Content="Copy" Style="{StaticResource SecondaryBtn}" Margin="8,0,0,0" Click="CopyTunnelUrl_Click"/>
                        </Grid>

                        <TextBlock Text="LAN URL (Same Wi-Fi)" FontSize="11.5" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="LanUrlBox" Style="{StaticResource DarkTextBox}" IsReadOnly="True"
                                     Text="http://127.0.0.1:8420" FontFamily="Consolas" FontSize="12"/>
                            <Button Grid.Column="1" Content="Copy" Style="{StaticResource SecondaryBtn}" Margin="8,0,0,0" Click="CopyLanUrl_Click"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="ToggleTunnelBtn" Content="Start Tunnel" Style="{StaticResource PrimaryBtn}" Margin="0,0,8,0" Click="ToggleTunnel_Click"/>
                            <Button x:Name="RestartServerBtn" Content="Restart Gateway" Style="{StaticResource SecondaryBtn}" Click="RestartServer_Click"/>
                        </StackPanel>

                        <TextBlock x:Name="TunnelStatusText" Text="Tunnel: Stopped" FontSize="12" Foreground="#9CA3AF"/>
                        <ProgressBar x:Name="TunnelProgressBar" Height="4" Minimum="0" Maximum="100" Value="0"
                                     Foreground="#38BDF8" Background="#1E2332" BorderThickness="0"
                                     Visibility="Collapsed" Margin="0,6,0,2"/>
                        <TextBlock x:Name="AgyStatusText" Text="Antigravity CLI: Checking..." FontSize="12" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                        <TextBlock x:Name="ActiveRunsText" Text="Active Agent Runs: 0" FontSize="12" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- QR Pairing Card -->
                <Border Background="#12151E" BorderBrush="#262B3D" BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="PAIR WEP IOS APP" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8"/>
                        <TextBlock Text="Open WEP on iPhone -> Scan QR Code to pair Tunnel + LAN + Token automatically."
                                   FontSize="12" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <Border Background="White" CornerRadius="10" Padding="10" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <Image x:Name="QrCodeImage" Width="210" Height="210" Stretch="Uniform"/>
                        </Border>

                        <TextBlock Text="Access Token" FontSize="11.5" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TokenBox" Style="{StaticResource DarkTextBox}" IsReadOnly="True" FontFamily="Consolas" FontSize="11.5"/>
                            <Button Grid.Column="1" Content="Copy" Style="{StaticResource SecondaryBtn}" Margin="6,0,0,0" Click="CopyToken_Click"/>
                            <Button Grid.Column="2" Content="Rotate" Style="{StaticResource SecondaryBtn}" Margin="6,0,0,0" Click="RotateToken_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Right Column: Configuration, Workspaces, Live Logs -->
            <Border Grid.Column="2" Background="#12151E" BorderBrush="#262B3D" BorderThickness="1" CornerRadius="12" Padding="16">
                <TabControl Background="Transparent" BorderThickness="0" Foreground="#F3F4F6">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Background" Value="#171B26"/>
                            <Setter Property="Foreground" Value="#9CA3AF"/>
                            <Setter Property="Padding" Value="14,8"/>
                            <Setter Property="Margin" Value="0,0,6,0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="TabBd" Background="{TemplateBinding Background}" BorderBrush="#262B3D" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter ContentSource="Header"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="TabBd" Property="Background" Value="#232942"/>
                                                <Setter TargetName="TabBd" Property="BorderBrush" Value="#6366F1"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <!-- Tab 1: Gateway & Tunnel Settings -->
                    <TabItem Header="Gateway &amp; Tunnel">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Host Device Name" FontSize="12" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                                <TextBox x:Name="DeviceNameBox" Style="{StaticResource DarkTextBox}" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Gateway Port" FontSize="12" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                                        <TextBox x:Name="PortBox" Style="{StaticResource DarkTextBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Antigravity CLI (agy.exe) Path" FontSize="12" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                                        <TextBox x:Name="AgyPathBox" Style="{StaticResource DarkTextBox}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Default Workspace Folder" FontSize="12" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="DefaultWorkspaceBox" Style="{StaticResource DarkTextBox}"/>
                                    <Button Grid.Column="1" Content="Browse..." Style="{StaticResource SecondaryBtn}" Margin="8,0,0,0" Click="BrowseWorkspace_Click"/>
                                </Grid>

                                <Border Background="#171B26" BorderBrush="#262B3D" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Cloudflare Tunnel Mode" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <ComboBox x:Name="TunnelModeCombo" Margin="0,0,0,10" Padding="8,6">
                                            <ComboBoxItem Content="Quick Tunnel (Free instant trycloudflare.com URL)" Tag="quick"/>
                                            <ComboBoxItem Content="Named Tunnel (Permanent custom domain via Cloudflare token)" Tag="named"/>
                                            <ComboBoxItem Content="Off (LAN / Tailscale direct only)" Tag="off"/>
                                        </ComboBox>

                                        <TextBlock Text="Cloudflare Named Tunnel Token (only for Named mode)" FontSize="11.5" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                                        <TextBox x:Name="CfTokenBox" Style="{StaticResource DarkTextBox}" Margin="0,0,0,10"/>

                                        <TextBlock Text="Custom Public Domain (e.g. https://wep.yourdomain.com)" FontSize="11.5" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                                        <TextBox x:Name="CustomDomainBox" Style="{StaticResource DarkTextBox}"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#171B26" BorderBrush="#262B3D" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Always-On Home PC Options" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <CheckBox x:Name="KeepAwakeCheck" Content="Keep PC awake while WEP Host is running (prevent sleep)" Foreground="#E5E7EB" Margin="0,4"/>
                                        <CheckBox x:Name="AutoStartCheck" Content="Launch WEP Host automatically when Windows starts" Foreground="#E5E7EB" Margin="0,4"/>
                                        <CheckBox x:Name="StartTunnelCheck" Content="Auto-open Cloudflare Tunnel on launch" Foreground="#E5E7EB" Margin="0,4"/>
                                        <CheckBox x:Name="TrayOnCloseCheck" Content="Minimize to System Tray when closing window" Foreground="#E5E7EB" Margin="0,4"/>
                                        <CheckBox x:Name="SkipPermCheck" Content="Auto-approve Antigravity tool runs remotely (--dangerously-skip-permissions)" Foreground="#E5E7EB" Margin="0,4"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Save &amp; Apply Settings" Style="{StaticResource PrimaryBtn}" Click="SaveSettings_Click"/>
                                    <Button Content="Copy Pairing JSON" Style="{StaticResource SecondaryBtn}" Margin="10,0,0,0" Click="CopyPairingJson_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 2: Allowed Roots & Pinned Folders -->
                    <TabItem Header="Workspaces &amp; Access">
                        <Grid Margin="0,14,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Allowed Root Directories (leave empty to allow browsing all Windows drives from authenticated WEP iOS app):"
                                       Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <ListBox x:Name="AllowedRootsList" Grid.Row="1" Background="#0E1118" Foreground="#F3F4F6"
                                     BorderBrush="#262B3D" BorderThickness="1" FontFamily="Consolas" FontSize="12" Padding="6"/>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Add Allowed Folder..." Style="{StaticResource PrimaryBtn}" Margin="0,0,8,0" Click="AddAllowedRoot_Click"/>
                                <Button Content="Remove Selected" Style="{StaticResource SecondaryBtn}" Click="RemoveAllowedRoot_Click"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <!-- Tab 3: Live Activity Console -->
                    <TabItem Header="Live Console">
                        <Grid Margin="0,14,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBox x:Name="LogTextBox" Background="#090B0F" Foreground="#D1D5DB"
                                     BorderBrush="#262B3D" BorderThickness="1" IsReadOnly="True"
                                     FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" Padding="10"/>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Clear View" Style="{StaticResource SecondaryBtn}" Click="ClearLog_Click"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</Window>
