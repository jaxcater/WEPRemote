<Window x:Class="WEP.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WEP Studio Host — Antigravity, Codex &amp; Cursor Remote"
        Icon="pack://application:,,,/Assets/wep.ico"
        Width="1200" Height="780" MinWidth="980" MinHeight="660"
        Background="#090B10"
        Foreground="#F3F4F6"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="62"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Studio Header -->
        <Border Grid.Row="0" Background="#10141E" BorderBrush="#23293B" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/wep.ico" Width="34" Height="34" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="WEP Studio Host" FontSize="15.5" FontWeight="Bold" Foreground="#F9FAFB"/>
                            <Border Background="#1E2538" CornerRadius="6" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v2.0" FontSize="10.5" FontWeight="SemiBold" Foreground="#38BDF8"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Remote Gateway for Antigravity • Codex • Live Cursor" FontSize="11.5" Foreground="#9CA3AF"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#151A28" BorderBrush="#262D42" BorderThickness="1" CornerRadius="14" Padding="11,5" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="CursorDot" Width="8" Height="8" Fill="#38BDF8" Margin="0,0,6,0"/>
                            <TextBlock x:Name="HeaderCursorStatus" Text="Cursor: Checking..." FontSize="11.5" Foreground="#D1D5DB"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#151A28" BorderBrush="#262D42" BorderThickness="1" CornerRadius="14" Padding="11,5" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ServerDot" Width="8" Height="8" Fill="#22C55E" Margin="0,0,6,0"/>
                            <TextBlock x:Name="HeaderServerStatus" Text="Gateway Online" FontSize="11.5" Foreground="#E5E7EB"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#151A28" BorderBrush="#262D42" BorderThickness="1" CornerRadius="14" Padding="11,5" Margin="0,0,10,0">
                        <TextBlock x:Name="HeaderClientsBadge" Text="0 iOS Connected" FontSize="11.5" Foreground="#38BDF8"/>
                    </Border>
                    <Button Content="Minimize to Tray" Style="{StaticResource SecondaryBtn}" Click="MinimizeToTray_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="365"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Pathway, Live Cursor & QR Pairing -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Pathway Card -->
                    <Border Background="#10141E" BorderBrush="#23293B" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="REMOTE PATHWAY" FontSize="10.5" FontWeight="Bold" Foreground="#6366F1" Margin="0,0,0,8"/>

                            <TextBlock Text="Public Tunnel URL (4G / 5G Anywhere)" FontSize="11.5" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TunnelUrlBox" Style="{StaticResource DarkTextBox}" IsReadOnly="True"
                                         Text="Waiting for tunnel..." FontFamily="Consolas" FontSize="11.5"/>
                                <Button Grid.Column="1" Content="Copy" Style="{StaticResource SecondaryBtn}" Margin="6,0,0,0" Click="CopyTunnelUrl_Click"/>
                            </Grid>

                            <TextBlock Text="LAN URL (Home Wi-Fi)" FontSize="11.5" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="LanUrlBox" Style="{StaticResource DarkTextBox}" IsReadOnly="True"
                                         Text="http://127.0.0.1:8420" FontFamily="Consolas" FontSize="11.5"/>
                                <Button Grid.Column="1" Content="Copy" Style="{StaticResource SecondaryBtn}" Margin="6,0,0,0" Click="CopyLanUrl_Click"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button x:Name="ToggleTunnelBtn" Content="Start Tunnel" Style="{StaticResource PrimaryBtn}" Margin="0,0,8,0" Click="ToggleTunnel_Click"/>
                                <Button x:Name="RestartServerBtn" Content="Restart Gateway" Style="{StaticResource SecondaryBtn}" Click="RestartServer_Click"/>
                            </StackPanel>

                            <TextBlock x:Name="TunnelStatusText" Text="Tunnel: Stopped" FontSize="11.5" Foreground="#9CA3AF"/>
                            <ProgressBar x:Name="TunnelProgressBar" Height="4" Minimum="0" Maximum="100" Value="0"
                                         Foreground="#38BDF8" Background="#1E2332" BorderThickness="0"
                                         Visibility="Collapsed" Margin="0,6,0,2"/>

                            <Border Background="#151A28" CornerRadius="8" Padding="10" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="EnginesSummaryText" Text="Engines: Checking Antigravity &amp; Codex..." FontSize="11.5" Foreground="#D1D5DB" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="ActiveRunsText" Text="Active Agent Runs: 0" FontSize="11.5" Foreground="#9CA3AF" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- QR Pairing Card -->
                    <Border Background="#10141E" BorderBrush="#23293B" BorderThickness="1" CornerRadius="12" Padding="15">
                        <StackPanel>
                            <TextBlock Text="PAIR WEP IOS APP" FontSize="10.5" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,6"/>
                            <TextBlock Text="Open WEP on iPhone -> Scan QR to pair Tunnel + LAN + Token."
                                       FontSize="11.5" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <Border Background="White" CornerRadius="10" Padding="8" HorizontalAlignment="Center" Margin="0,0,0,10">
                                <Image x:Name="QrCodeImage" Width="190" Height="190" Stretch="Uniform"/>
                            </Border>

                            <TextBlock Text="Access Token" FontSize="11.5" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TokenBox" Style="{StaticResource DarkTextBox}" IsReadOnly="True" FontFamily="Consolas" FontSize="11"/>
                                <Button Grid.Column="1" Content="Copy" Style="{StaticResource SecondaryBtn}" Margin="6,0,0,0" Click="CopyToken_Click"/>
                                <Button Grid.Column="2" Content="Rotate" Style="{StaticResource SecondaryBtn}" Margin="6,0,0,0" Click="RotateToken_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Right Column: Multi-Tab Control Center -->
            <Border Grid.Column="2" Background="#10141E" BorderBrush="#23293B" BorderThickness="1" CornerRadius="12" Padding="16">
                <TabControl Background="Transparent" BorderThickness="0" Foreground="#F3F4F6">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Background" Value="#151A28"/>
                            <Setter Property="Foreground" Value="#9CA3AF"/>
                            <Setter Property="Padding" Value="13,7"/>
                            <Setter Property="Margin" Value="0,0,6,0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="TabBd" Background="{TemplateBinding Background}" BorderBrush="#23293B" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter ContentSource="Header"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="TabBd" Property="Background" Value="#1F2740"/>
                                                <Setter TargetName="TabBd" Property="BorderBrush" Value="#6366F1"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <!-- Tab 1: Live Cursor & Codex Sessions -->
                    <TabItem Header="Live Cursor &amp; Codex">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Active Cursor Window Card -->
                            <Border Grid.Row="0" Background="#151A28" BorderBrush="#262D42" BorderThickness="1" CornerRadius="10" Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="ACTIVE CURSOR SESSION" FontSize="10.5" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="CursorLiveWorkspaceText" Text="Detecting open Cursor workspace..." FontSize="13" FontWeight="SemiBold" Foreground="#F3F4F6" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="CursorWindowTitlesText" Text="" FontSize="11.5" Foreground="#9CA3AF" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <Button Content="Refresh Live" Style="{StaticResource SecondaryBtn}" Margin="0,0,0,6" Click="RefreshCursorLive_Click"/>
                                        <Button Content="Set as Default" Style="{StaticResource PrimaryBtn}" Click="SyncCursorWorkspace_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Recent Workspaces & Codex Threads -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#151A28" BorderBrush="#262D42" BorderThickness="1" CornerRadius="10" Padding="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Recent Cursor Workspaces" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <ListBox x:Name="CursorWorkspacesList" Grid.Row="1" Background="#0D1017" Foreground="#E5E7EB"
                                                 BorderBrush="#23293B" FontFamily="Consolas" FontSize="11.5"/>
                                        <Button Grid.Row="2" Content="Open Selected in Cursor" Style="{StaticResource SecondaryBtn}" Margin="0,8,0,0" Click="OpenSelectedInCursor_Click"/>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2" Background="#151A28" BorderBrush="#262D42" BorderThickness="1" CornerRadius="10" Padding="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Recent Codex Threads (~/.codex)" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <ListBox x:Name="CodexThreadsList" Grid.Row="1" Background="#0D1017" Foreground="#E5E7EB"
                                                 BorderBrush="#23293B" FontSize="12"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- Tab 2: Extensions & Plugins Manager -->
                    <TabItem Header="Extensions &amp; Plugins">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ExtensionInstallBox" Style="{StaticResource DarkTextBox}"
                                         ToolTip="Enter Cursor extension ID (e.g. esbenp.prettier-vscode)"/>
                                <Button Grid.Column="1" x:Name="InstallExtBtn" Content="Install Cursor Ext" Style="{StaticResource PrimaryBtn}" Margin="8,0,0,0" Click="InstallExtension_Click"/>
                                <Button Grid.Column="2" Content="Update All" Style="{StaticResource SecondaryBtn}" Margin="6,0,0,0" Click="UpdateExtensions_Click"/>
                                <Button Grid.Column="3" Content="Refresh" Style="{StaticResource SecondaryBtn}" Margin="6,0,0,0" Click="RefreshExtensions_Click"/>
                            </Grid>

                            <ListBox x:Name="ExtensionsListBox" Grid.Row="1" Background="#0D1017" Foreground="#F3F4F6"
                                     BorderBrush="#23293B" BorderThickness="1" Padding="6" FontSize="12"/>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Uninstall Selected" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0" Click="UninstallSelectedExtension_Click"/>
                                <Button Content="Toggle Selected Antigravity Plugin" Style="{StaticResource SecondaryBtn}" Click="ToggleSelectedPlugin_Click"/>
                                <TextBlock x:Name="ExtStatusText" Text="" FontSize="11.5" Foreground="#38BDF8" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <!-- Tab 3: Gateway, Engines & Tunnel Settings -->
                    <TabItem Header="Gateway &amp; Engines">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Host Device Name" FontSize="11.5" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                                        <TextBox x:Name="DeviceNameBox" Style="{StaticResource DarkTextBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Gateway Port" FontSize="11.5" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                                        <TextBox x:Name="PortBox" Style="{StaticResource DarkTextBox}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Antigravity CLI (agy.exe)" FontSize="11.5" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                                <TextBox x:Name="AgyPathBox" Style="{StaticResource DarkTextBox}" Margin="0,0,0,10"/>

                                <TextBlock Text="Codex CLI (codex.exe)" FontSize="11.5" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                                <TextBox x:Name="CodexPathBox" Style="{StaticResource DarkTextBox}" Margin="0,0,0,10"/>

                                <TextBlock Text="Cursor CLI (cursor.cmd)" FontSize="11.5" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                                <TextBox x:Name="CursorPathBox" Style="{StaticResource DarkTextBox}" Margin="0,0,0,10"/>

                                <TextBlock Text="Default Workspace Folder" FontSize="11.5" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="DefaultWorkspaceBox" Style="{StaticResource DarkTextBox}"/>
                                    <Button Grid.Column="1" Content="Browse..." Style="{StaticResource SecondaryBtn}" Margin="8,0,0,0" Click="BrowseWorkspace_Click"/>
                                </Grid>

                                <Border Background="#151A28" BorderBrush="#262D42" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Cloudflare Tunnel Mode" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <ComboBox x:Name="TunnelModeCombo" Margin="0,0,0,8" Padding="8,6">
                                            <ComboBoxItem Content="Quick Tunnel (Free instant trycloudflare.com URL)" Tag="quick"/>
                                            <ComboBoxItem Content="Named Tunnel (Permanent custom domain via Cloudflare token)" Tag="named"/>
                                            <ComboBoxItem Content="Off (LAN / Tailscale direct only)" Tag="off"/>
                                        </ComboBox>
                                        <TextBox x:Name="CfTokenBox" Style="{StaticResource DarkTextBox}" Margin="0,0,0,8" ToolTip="Cloudflare Named Tunnel Token"/>
                                        <TextBox x:Name="CustomDomainBox" Style="{StaticResource DarkTextBox}" ToolTip="Custom Public Domain e.g. https://wep.yourdomain.com"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#151A28" BorderBrush="#262D42" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Always-On Home PC Options" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <CheckBox x:Name="KeepAwakeCheck" Content="Keep PC awake while WEP Host is running" Foreground="#E5E7EB" Margin="0,3"/>
                                        <CheckBox x:Name="AutoStartCheck" Content="Launch WEP Host automatically when Windows starts" Foreground="#E5E7EB" Margin="0,3"/>
                                        <CheckBox x:Name="StartTunnelCheck" Content="Auto-open Cloudflare Tunnel on launch" Foreground="#E5E7EB" Margin="0,3"/>
                                        <CheckBox x:Name="TrayOnCloseCheck" Content="Minimize to System Tray when closing window" Foreground="#E5E7EB" Margin="0,3"/>
                                        <CheckBox x:Name="SkipPermCheck" Content="Auto-approve remote Antigravity/Codex tool runs" Foreground="#E5E7EB" Margin="0,3"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Save &amp; Apply Settings" Style="{StaticResource PrimaryBtn}" Click="SaveSettings_Click"/>
                                    <Button Content="Copy Pairing JSON" Style="{StaticResource SecondaryBtn}" Margin="10,0,0,0" Click="CopyPairingJson_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 4: Workspaces & Allowed Roots -->
                    <TabItem Header="Workspaces &amp; Access">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Allowed Root Directories (leave empty to allow browsing all Windows drives from authenticated WEP iOS):"
                                       Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <ListBox x:Name="AllowedRootsList" Grid.Row="1" Background="#0D1017" Foreground="#F3F4F6"
                                     BorderBrush="#23293B" BorderThickness="1" FontFamily="Consolas" FontSize="12" Padding="6"/>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Add Allowed Folder..." Style="{StaticResource PrimaryBtn}" Margin="0,0,8,0" Click="AddAllowedRoot_Click"/>
                                <Button Content="Remove Selected" Style="{StaticResource SecondaryBtn}" Click="RemoveAllowedRoot_Click"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <!-- Tab 5: Live Console -->
                    <TabItem Header="Live Console">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBox x:Name="LogTextBox" Background="#080A0F" Foreground="#D1D5DB"
                                     BorderBrush="#23293B" BorderThickness="1" IsReadOnly="True"
                                     FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" Padding="10"/>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Clear View" Style="{StaticResource SecondaryBtn}" Click="ClearLog_Click"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</Window>
